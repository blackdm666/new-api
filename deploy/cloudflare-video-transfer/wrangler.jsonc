{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "new-api-video-transfer",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "limits": {
    "cpu_ms": 300000,
  },
  "r2_buckets": [
    {
      "binding": "VIDEO_BUCKET",
      "bucket_name": "88api-videos",
    },
  ],
}
