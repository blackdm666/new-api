{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "new-api-video-transfer",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "cache": { "enabled": true },
  "routes": [
    {
      "pattern": "assets.88api.ai",
      "custom_domain": true,
    },
  ],
  "vars": {
    "PUBLIC_MEDIA_ENABLED": "true",
    "MEDIA_RETENTION_DAYS": "7",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "limits": {
    "cpu_ms": 300000,
  },
  "r2_buckets": [
    {
      "binding": "VIDEO_BUCKET",
      "bucket_name": "88api-videos",
    },
  ],
}
